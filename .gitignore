# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node modules (but NOT dist/ — we ship the built frontend)
frontend/node_modules/

# Environment
.env
.env.local
.env.*

# Data files — the whole backend/data/ tree (live DB, deploy backups, cloned
# repos) stays off GitHub; the app creates the directory at startup.
backend/data/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cline (agent config / memory) — local tooling, not part of the app
.cline/
.clinerules

# OS
.DS_Store
Thumbs.db

# Logs / temp
*.log
*.pid
*.sqlite3
build/
*.egg
.oxlintrc.json

# ── Secrets — never commit ──
# GitHub App private keys
*.pem
*private-key*
auto-release-notes.*